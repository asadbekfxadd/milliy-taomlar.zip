# PostgreSQL (Railway подставит сам, если подключить сервис Postgres через ${{Postgres.DATABASE_URL}})
DATABASE_URL="postgresql://user:password@localhost:5432/milliy"

# Вход в /admin
ADMIN_PASSWORD="придумайте-длинный-пароль"
# Любая случайная строка от 32 символов (например: openssl rand -hex 32)
SESSION_SECRET="замените-на-случайную-строку-минимум-32-символа"

# Адрес сайта без слэша в конце (для SEO, sitemap и кнопок Telegram)
PUBLIC_URL="https://milliy-taomlar.up.railway.app"

# Telegram: бот от @BotFather и id чата, куда слать заказы
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Любая случайная строка: защищает адрес для кнопок статуса
TELEGRAM_WEBHOOK_SECRET=""

# Код входа для персонала (/staff): касса, кухня, печать
STAFF_PIN=""

# Онлайн-оплата Payme (кабинет Payme Business). Для теста: PAYME_CHECKOUT_URL=https://test.paycom.uz
# Адрес для Payme: <PUBLIC_URL>/api/pay/payme, поле счёта: order_id
PAYME_MERCHANT_ID=""
PAYME_KEY=""
PAYME_CHECKOUT_URL=""

# Онлайн-оплата Click (merchant.click.uz). Prepare и Complete URL: <PUBLIC_URL>/api/pay/click
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""
